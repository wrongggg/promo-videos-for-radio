# Required for track curation (server/curator.py calls the Anthropic API with web search)
ANTHROPIC_API_KEY=

# Required for Google Sign-In (server/app.py) -- create at console.cloud.google.com,
# authorized redirect URI must be <your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flask session signing key. Auto-generated into this file for local dev if left
# blank -- but MUST be set explicitly when hosted (e.g. on Railway), since the
# container filesystem doesn't persist an auto-generated one across deploys.
FLASK_SECRET_KEY=

# One-time bootstrap: grants admin (Pop Lock curation, web search, /analytics)
# to this email on startup. Safe to leave set permanently, or remove after
# first deploy and manage further admins with server/manage_users.py locally.
INITIAL_ADMIN_EMAIL=

# Where persistent data lives (renders, analytics, admins, user cookies).
# Leave unset for local dev. When hosted, point this at a mounted volume
# (e.g. /data on Railway) so it survives redeploys.
DATA_DIR=
