# Required for track curation (server/curator.py calls the Anthropic API with web search)
ANTHROPIC_API_KEY=

# Google sign-in. Optional -- leave both blank and the app runs with everyone
# anonymous, every export watermarked, and the sign-in button hidden. Signing in
# is never needed to GENERATE a promo; it exists so credits have somewhere to
# live, since a credit balance tied to a cookie would vanish when the cookie did.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add this exact authorised redirect URI:
#   http://localhost:5050/auth/google/callback     (local dev)
#   https://<your-domain>/auth/google/callback     (hosted)
# The path must match character for character or Google returns
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credit coupons, as CODE:credits pairs. Redeemable once per account; the
# credits never expire. Kept in the environment rather than in a file in the
# repo so a live code is never committed. Restart to add one.
#   COUPONS=KZRADIO2026:25,LAUNCH:5
COUPONS=

# Flask session signing key. Auto-generated into this file for local dev if left
# blank -- but MUST be set explicitly when hosted (e.g. on Railway), since the
# container filesystem doesn't persist an auto-generated one across deploys.
FLASK_SECRET_KEY=

# Operator access. There is no sign-in: visiting /o/<ADMIN_TOKEN> once in a
# browser grants that browser the operator perks (AI curation, web search, the
# Opus quality mode, custom/saved themes, unlimited manual tracks, /analytics,
# and the operator-only YouTube source) via a long-lived session cookie.
# Leave blank to disable operator mode entirely -- /o/<anything> then 404s.
# Use a long random value: openssl rand -hex 24
ADMIN_TOKEN=

# Station link. Visiting /s/<STATION_TOKEN> once grants a browser the station
# logo as its default -- and nothing else. Hand this URL to colleagues at the
# station; it is deliberately weaker than ADMIN_TOKEN. Leave blank and /s/ 404s,
# so only the operator can use the station logo.
# Use a long random value: openssl rand -hex 24
STATION_TOKEN=

# Optional. Path to a Netscape-format cookies.txt for the operator's own
# YouTube fallback. Only ever used when the requesting session is the operator;
# every other job resolves audio exclusively from the licensed catalog
# previews (iTunes / Deezer). Leave unset to disable the YouTube path entirely.
YOUTUBE_COOKIE_FILE=

# Jobs allowed per IP per rolling 24h for anonymous visitors (operator exempt).
# Defaults to 3 -- enough to be convinced the tool works, not enough to never
# need an account. Raise it if a station behind a single NAT complains.
DAILY_JOB_LIMIT=

# Days a finished job's files stay on disk before being deleted. Defaults to 7.
# Each job leaves ~37 MB (master + watermarked copy + per-track clips), so on a
# billed volume this is what stops storage becoming the tool's largest cost.
# Set 0 to keep everything forever.
RENDER_RETENTION_DAYS=

# Where persistent data lives (renders, analytics, saved themes, catalog cache).
# Leave unset for local dev. When hosted, point this at a mounted volume
# (e.g. /data on Railway) so it survives redeploys.
DATA_DIR=
